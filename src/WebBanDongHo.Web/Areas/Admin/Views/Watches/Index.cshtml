@model IReadOnlyList<WebBanDongHo.Web.Models.AppWatch>

@{
    ViewData["Title"] = "Quản trị sản phẩm";
}

<div class="admin-page-header mb-3">
    <div>
        <h1 class="h3 mb-1">Quản trị sản phẩm</h1>
        <p class="text-muted mb-0">Theo dõi tồn kho, tối ưu danh mục và cập nhật thông tin sản phẩm nhanh.</p>
    </div>
    <a class="btn btn-dark" asp-action="Create">Thêm sản phẩm</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<form method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label">Tìm kiếm</label>
            <input type="text" class="form-control" name="keyword" value="@ViewData["Keyword"]" placeholder="Tìm theo tên, SKU, thương hiệu" />
        </div>
        <div class="col-12 col-md-3">
            <button type="submit" class="btn btn-outline-dark w-100">Tìm sản phẩm</button>
        </div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>SKU</th>
                <th>Sản phẩm</th>
                <th>Thương hiệu</th>
                <th>Giá</th>
                <th>Tồn kho</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">Chưa có sản phẩm.</td>
            </tr>
        }
        else
        {
            @foreach (var watch in Model)
            {
                <tr>
                    <td>@watch.Sku</td>
                    <td>@watch.Name</td>
                    <td>@watch.Brand</td>
                    <td>@watch.Price.ToString("N0") đ</td>
                    <td>@watch.Stock</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@watch.Id">Sửa</a>
                        <form asp-action="Delete" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@watch.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc muốn ẩn sản phẩm này?');">Ẩn</button>
                        </form>
                    </td>
                </tr>
            }
        }
        </tbody>
        </table>
    </div>
</div>
