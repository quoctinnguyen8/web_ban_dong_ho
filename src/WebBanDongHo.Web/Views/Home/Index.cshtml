@model IReadOnlyList<WebBanDongHo.Web.Models.AppWatch>

@{
    ViewData["Title"] = "Trang chủ";
}

<section class="mb-4">
    <h1 class="display-5 fw-bold">Bộ sưu tập đồng hồ</h1>
    <p class="text-muted mb-0">Khám phá những mẫu đồng hồ nổi bật dành cho người yêu phong cách tinh tế.</p>
</section>

@if (!Model.Any())
{
    <div class="alert alert-info">Chưa có sản phẩm. Vui lòng chạy migration để tạo dữ liệu mẫu.</div>
}
else
{
    <div class="row g-4">
        @foreach (var watch in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <article class="card h-100 shadow-sm border-0">
                    @if (!string.IsNullOrWhiteSpace(watch.ImageUrl))
                    {
                        <img src="@watch.ImageUrl" class="card-img-top" alt="@watch.Name" style="height:220px;object-fit:cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <p class="text-uppercase small text-muted mb-1">@watch.Sku</p>
                        <h2 class="h5 mb-2">@watch.Name</h2>
                        <p class="text-muted small mb-3">@watch.ShortDescription</p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">@watch.Price.ToString("N0") đ</span>
                            <span class="badge bg-light text-dark">@watch.Stock chiếc</span>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <a class="btn btn-outline-dark btn-sm" asp-controller="Products" asp-action="Details" asp-route-id="@watch.Id">Xem chi tiết</a>
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="watchId" value="@watch.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-dark btn-sm">Thêm giỏ hàng</button>
                            </form>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
